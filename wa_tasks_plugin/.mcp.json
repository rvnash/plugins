{
  "mcpServers": {
    "Linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "Google Drive": {
      "type": "http",
      "url": "https://drivemcp.googleapis.com/mcp/v1"
    },
    "Gmail": {
      "type": "http",
      "url": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "Fathom": {
      "type": "http",
      "url": "https://api.fathom.ai/mcp"
    },
    "Basecamp": {
      "command": "${BASECAMP_MCP_PYTHON}",
      "args": ["${BASECAMP_MCP_SCRIPT}"],
      "env": {
        "BASECAMP_CLIENT_ID": "${BASECAMP_CLIENT_ID}",
        "BASECAMP_CLIENT_SECRET": "${BASECAMP_CLIENT_SECRET}",
        "BASECAMP_ACCOUNT_ID": "${BASECAMP_ACCOUNT_ID}",
        "USER_AGENT": "${BASECAMP_USER_AGENT}"
      }
    }
  }
}
